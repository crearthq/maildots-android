<?xml version="1.0" encoding="utf-8"?>
<!-- Düz metin trafik yasak. Yalnızca sistemin güvendiği sertifika otoriteleri kabul
     edilir; kullanıcının cihaza eklediği otoriteler (araya girme proxy'leri) REDDEDİLİR. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
