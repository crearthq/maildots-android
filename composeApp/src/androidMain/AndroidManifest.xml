<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Yeni posta bildirimi (Android 13+ kullanıcıdan izin ister). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Güvenlik: yedekleme kapalı (şifreli depo cihazdan çıkmaz), düz HTTP kapalı,
         yalnızca sistem sertifika otoriteleri güvenilir (kullanıcı eklediği CA'lar DEĞİL). -->
    <application
        android:name=".MailDotsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="MailDots"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MailDots"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Anlık bildirim servisi: dışa açık değildir, yalnızca Firebase çağırır. -->
        <service
            android:name=".push.MailPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Ana ekran widget'ı (son e-postalar). AppWidget çatısı gereği dışa açık; yalnızca standart
             güncelleme süzgeci. Yeni izin yok; widget ağa çıkmaz, uygulamanın şifreli özetini okur. -->
        <receiver
            android:name=".widget.InboxWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

        <!-- Reklam kimliği ve analiz toplanmaz. -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <!-- Sistemin kendisi gösterdiği bildirimlerde de (FCM "notification" iletisi) marka simgesi ve rengi. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_maildots" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/brand_blue" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="new_mail" />

        <!-- Ek önizleme: dosyalar dışa aktarılmaz; yalnızca tek seferlik okuma izniyle paylaşılır. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
